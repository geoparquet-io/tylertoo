# built tippecanoe (setup_tippecanoe.sh) — source + install prefix + build log
.tools/

# generated by setup_tippecanoe.sh and machine-local (it names a built binary).
# The authoritative pin is TIPPECANOE_TAG/TIPPECANOE_SHA in that script, and
# the tag + SHA actually measured are recorded inside results.json.
tippecanoe.lock.json

# visual-parity output
renders/

# ad-hoc runs; the committed record is results.json + RESULTS.md, written
# deliberately, not whatever the last local run happened to produce
results-*.json
*.pmtiles
*.fgb
*.geojsonseq
