  "schema_version": 1,
  "description": "tylertoo overview test corpus. Datasets per geometry class (point/line/polygon/monster) at small/medium/large scale tiers. Scripts only; data never committed.",
  "overture": {
    "release": "2026-10-21.0",
    "bucket": "s3://overturemaps-us-west-2/release",
    "region": "us-west-2",
    "release_note": "Pinned release, re-pinned 2026-11-06 (#696: 2026-06-17.0 left the bucket). benchmarks/manifest.toml uses the same release (test_run_manifest.py checks it). Overture extracts are pinned by exact row count and ids_sha256 = sha256 of the extract's ids sorted and joined with ',' (DuckDB: sha256(string_agg(id, ',' ORDER BY id))), which is independent of the parquet writer; fetch.sh checks both and fails on a mismatch. Releases expire after a few months: re-pin all of them together."
  },
  "profiles": {
    "default": "small + medium tiers, target < 2-3 GB total (fetch.sh)",
    "large": "adds large tier state/country datasets (fetch.sh --large)",
    "manual": "documented candidate, not auto-fetched (needs human confirmation)"
  },
